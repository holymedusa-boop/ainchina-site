px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"12–18 months"}]]}]]}],["$","tr","2",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Deep OpenAI partnership"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Low (political)"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"N/A"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Uncertain"}]]}]]}],["$","tr","3",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Double down on product"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"High"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$2–3B/year"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Ongoing"}]]}]]}],["$","tr","4",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Accept follower role"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"High (by default)"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":