x 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Manufacturing robots"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":">20"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":">2.9"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Jinding Capital"}]]}]]}],["$","tr","6",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Spirit AI"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Universal robot brain"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":">10"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":">1.5"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"HongShan, Xiaomi"}]]}]]}]]}]]}]}],["$","img","77",{"src":"https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=800&h=400&fit=crop","alt":"AI chip and neural network processing for robotics","style":{"width":"100%","borderRadius":"12px","margin":"24px 0"}}],["$","p","78",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*The \"brain\" layer of embodied AI—vision-language-action models running on specialized silicon—is attracting capital at unprecedented scale. Photo: Unsplash*"}]]}],["$","h2","80",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"From Demo to Delivery: The Shift That Separates Winners from Hype"}]]}],["$","p","82",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Perhaps the most significant evolution in 2026 is the shift in investment criteria. Industry analysts note that the logic has moved from \"look at the team, look at the demo\" to \"show me the delivery, show me the data loop.\" This is a consequential change for a sector that has historically been rich in viral videos and poor in unit economics."}]]}],["$","p","84",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The production numbers emerging from leading companies validate this shift. ZhiYuan (智元) has produced 15,000 units. UBTECH's U1 series, priced at CNY 119,800 (approximately $16,700), has accumulated pre-orders exceeding 13,361 units with deliveries scheduled to begin on September 16, 2026. Deep Robotics, Leju Robotics, and others have entered the IPO process, suggesting they have revenue trajectories sufficient to satisfy public market scrutiny."}]]}],["$","p","86",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The investment concentration across three categories—embodied AI LLMs, training data collection, and delivery capabilities—reflects a maturation of the industry's understanding of what it takes to build a viable robotics business. A brilliant robot brain is useless without a manufacturing pipeline; a manufacturing pipeline is inefficient without training data at scale; and training data requires deployed robots in real environments."}]]}],["$","div","93",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","