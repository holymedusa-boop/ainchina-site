8:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"China's Physical AI Awakening: World Models, Robot IPOs, and the $295 Billion Bet on Embodied Intelligence | AI in China"}],["$","meta","3",{"name":"description","content":"In a single week, China unveiled the world's first general world foundation model, a humanoid robot maker filed for IPO, and Beijing prepared a $295 billion nationwide AI buildout. The physical AI era has arrived."}],["$","link","4",{"rel":"author","href":"https://www.ainchina.com/about/"}],["$","meta","5",{"name":"author","content":"Meeeeed@AI in China"}],["$","meta","6",{"name":"keywords","content":"[\"China world model\", \"Physis BAAI\", \"embodied intelligence\", \"humanoid robot IPO\", \"EngineAI\", \"China AI buildout\", \"physical AI\", \"robotics China 2026\", \"AI liability China\", \"Beijing Academy of AI\"]"}],["$","meta","7",{"name":"creator","content":"AI in China"}],["$","meta","8",{"name":"publisher","content":"AI in China"}],["$","meta","9",{"name":"robots","content":"index, follow"}],["$","meta","10",{"name":"googlebot","content":"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}],["$","link","11",{"rel":"canonical","href":"https://www.ainchina.com/blog/china-physical-ai-awakening-world-models-robot-ipos-295b-bet-2026/"}],["$","meta","12",{"property":"og:title","content":"China's Physical AI Awakening: World Models, Robot IPOs, and the $295 Billion Bet on Embodied Intelligence"}],["$","meta","13",{"property":"og:description","content":"In a single week, China unveiled the world's first general world foundation model, a humanoid robot maker filed for IPO, and Beijing prepared a $295 billion nationwide AI buildout. The physical AI era has arrived."}],["$","meta","14",{"property":"og:url","content":"https://www.ainchina.com/blog/china-physical-ai-awakening-world-models-robot-ipos-295b-bet-2026/"}],["$