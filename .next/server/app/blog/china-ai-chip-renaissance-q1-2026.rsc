\" — a separate world that coexists but doesn't compete with the Nvidia-dominated global market. The Q1 2026 earnings suggest that characterization is becoming obsolete."}]]}],["$","p","229",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"China's domestic AI chip industry is now a competing ecosystem."}]]}],["$","div","238",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Dimension"}]]}],["$","th","1",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Global Ecosystem"}]]}],["$","th","2",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"China Ecosystem"}]]}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Leading Hardware"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Nvidia (H100/H200/Blackwell)"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Cambricon, Hygon, Huawei Ascend"}]]}]]}],["$","tr","1",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"