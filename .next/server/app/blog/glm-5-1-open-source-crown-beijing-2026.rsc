5"},"children":[["$","span","0",{"children":"Partial (interference)"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Full"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Full"}]]}]]}],["$","tr","3",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Domestic Compute %"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"100%"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~80%"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~0%"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~0%"}]]}]]}],["$","tr","4",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Training Cost Estimate"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Undisclosed"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~$5.6M"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Undisclosed"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Undisclosed"}]]}]]}]]}]]}]}],["$","p","70",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*Data from technical reports, industry analysis, and company disclosures (2026)*"}]]}],["$","p","72",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"For years, the dominant narrative in Washington and Silicon Valley has been that these export controls create a \"compute moat\" — an insurmountable gap in training capability that guarantees American AI labs will maintain a permanent lead. DeepSeek's V3 model, trained for approximately $5.6 million on a cluster of NVIDIA H800s (the downgraded chips China could still access), had already challenged this narrative by matching GPT-4's performance at a fraction of the cost. But DeepSeek still used NVIDIA chips."}]]}],["$","p","74",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"GLM-5.1 goes further. It proves that a frontier-level model can be trained entirely on Chinese domestic hardware. The Ascend 910B is a 7nm AI processor with 310 teraflops of FP16 performance — competitive with the NVIDIA A100 but behind the H100. Training a 754-billion-parameter MoE model on this hardware required not just raw compute but also sophisticated software optimization, distributed training algorithms, and what Z.ai engineers describe as \"aggressive pipeline parallelism\" to compensate for the interconnect bandwidth differences between Ascend and NVIDIA architectures."}]]}],["$","p","76",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The achievement has implications that extend far beyond Zhipu AI. It means that China's AI industry now has a proven pathway to train frontier models without any dependence on Western semiconductor technology. The next generation of Ascend chips — the 910C, reportedly sampling in late 2026 — is expected to close the remaining performance gap with NVIDIA's H200. If Zhipu can train a SWE-Bench Pro leader on the 910B, the industry is already asking what the 910C generation will make possible."}]]}],["$","h2","78",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"The Licensing Choice: Why MIT Matters"}]]}],["$","p","80",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"GLM-5.1's release under the MIT License is not a minor footnote. It is a strategic decision with profound implications for adoption and ecosystem development. The MIT License is one of the most permissive open-source licenses available: it allows commercial use, modification, distribution, and even creation of closed-source derivative works without requiring attribution beyond the original copyright notice."}]]}],["$","p","82",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Compare this to the licensing landscape of other frontier models:"}]]}],["$","div","93",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Model"}]]}],["$","th","1",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"License"}]]}],["$","th","2",{"style":{"borderBottom":"2px solid