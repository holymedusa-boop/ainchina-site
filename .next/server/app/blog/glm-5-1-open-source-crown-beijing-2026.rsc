solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Undisclosed"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"AA Intelligence 56.6"}]]}],["$","td","5",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Proprietary"}]]}],["$","td","6",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"1M-token closed-weight flagship"}]]}]]}]]}]]}]}],["$","p","111",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*Data from company announcements and independent benchmark evaluations (April-June 2026)*"}]]}],["$","p","113",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The convergence is striking. Between April 7 and May 20, 2026 — a span of just six weeks — four Chinese labs released models that collectively hold the top positions on global open-source leaderboards. DeepSeek V4 Pro leads on GDPval-AA, a real-world agentic performance metric. Kimi K2.6 ties GLM-5.1 on SWE-Bench Pro and tops the broader coding composite. GLM-5.1 holds the crown for sustained autonomous execution and the most permissive license. Qwen 3.7 Max, while closed-weight, brings a 1-million-token context window to the closed-source tier."}]]}],["$","p","115",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"This is not the pattern of a \"copycat\" ecosystem. It is the pattern of an ecosystem that has reached technical maturity. Each lab has chosen a different optimization target: DeepSeek for cost efficiency, Kimi for coding composite, GLM for sustained autonomy, Qwen for context length. The diversity of approaches suggests that Chinese labs are no longer playing catch-up — they are setting their own research agendas."}]]}],["$","h2","117",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"The Business Model: From Research to Revenue"}]]}],["$","p","119",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Zhipu AI's trajectory from Tsinghua University spinoff to publicly traded company provides essential context for understanding GLM-5.1's release strategy. The company went public on the Hong Kong Stock Exchange in January 2026, becoming the first of China's \"Big Five\" AI model companies to list. Its stock price has surged over 1,600% since the IPO, pushing its market capitalization to approximately "}],["$","strong","1",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"HK$880 billion"}],["$","span","2",{"children":" (~$113 billion USD) as of late May 2026."}]]}],["$","p","121",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Despite the astronomical valuation, Zhipu's revenue remains modest. The company reported "}],["$","strong","1",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"¥724 million"}],["$","span","2",{"children":" (~$100 million USD) in 2025 revenue, a 132% year-over-year increase but still tiny relative to its market cap. This valuation disconnect reflects investor belief that Zhipu is not merely an AI company but a platform for compute sovereignty — a bet that Chinese enterprises will increasingly prefer domestic models trained on domestic hardware for both performance and geopolitical reasons."}]]}],["$","div","130",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","thead",null,{"