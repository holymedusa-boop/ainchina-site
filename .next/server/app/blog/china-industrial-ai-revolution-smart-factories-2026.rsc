ope."}]]}],["$","img","36",{"src":"https://images.unsplash.com/photo-1565043666747-69f6646db940?w=800&q=80","alt":"Automated assembly line in modern factory","style":{"width":"100%","borderRadius":"12px","margin":"24px 0"}}],["$","p","37",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*An AI-enabled automated assembly line at a steel manufacturing facility in Jiangsu Province. Design efficiency has jumped 66% while headcount remained flat. (Photo: Unsplash)*"}]]}],["$","h3","39",{"style":{"fontSize":"22px","fontWeight":"600","margin":"32px 0 16px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"Enterprise AI Efficiency Gains: Real Case Studies"}]]}],["$","div","49",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Company / Factory"}]]}],["$","th","1",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Sector"}]]}],["$","th","2",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"AI Deployment Period"}]]}],["$","th","3",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Output Change"}]]}],["$","th","4",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Headcount Change"}]]}],["$","th","5",{