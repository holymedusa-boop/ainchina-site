5"},"children":[["$","span","0",{"children":"Industrial + consumer (G1, R1)"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$5,900–$13,500"}]]}]]}],["$","tr","2",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"UBTECH"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"1,800 units"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"12,000"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"BYD factory (100–200 units deployed)"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$20,000–$40,000"}]]}]]}],["$","tr","3",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Fourier Intelligence"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"420 units"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"3,000"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Healthcare & rehabilitation"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~$150,000"}]]}]]}],["$","tr","4",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"XPENG Robotics"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"180 units"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"5,000"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"IRON humanoid for EV manufacturing"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"TBD"}]]}]]}],["$","tr","5",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Tesla (Optimus)"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~150 units"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"2,000"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Internal Tesla factories"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Not commercially priced"}]]}]]}],["$","tr","6",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Figure AI"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~150 units"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"1,500"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"BMW pilot program"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Not commercially priced"}]]}]]}]]}]]}]}],["$","p","60",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*Sources: Omdia global humanoid shipment report, 2025; SVRC Research China Robotics 2026; MIIT press briefing, July 7, 2026; company announcements.*"}]]}],["$","p","62",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"What's driving this production explosion? Three factors, each reinforcing the others."}]]}],["$","p","64",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Supply chain density"}],["$","span","1",{"children":" is the first. Within a 100-kilometer radius of Shenzhen, a robotics startup can source brushless DC motors, harmonic drives, strain wave gears, CNC-machined aluminum frames, custom PCBs, depth cameras, and force-torque sensors — often with first samples delivered within a week. A prototype that costs $15,000–$25,000 and takes 10–14 weeks in the United States can be produced in Shenzhen for $4,000–$8,000 in 10–14 days. This is not a marginal advantage. It is a structural one that shapes the entire competitive landscape."}]]}],["$","p","66",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"The EV-to-robot manufacturing pipeline"}],["$","span","1",{"children":" is the second. China's dominance in electric vehicles created a vast ecosystem of precision actuators, battery management systems, and sensor fusion technologies — all directly transferable to humanoid robotics. BYD alone, the world's largest EV manufacturer, employs over 700,000 workers and represents a demand base for tens of thousands of robotic systems. The same factories that learned to assemble batteries and motors at scale are now learning to assemble robots."}]]}],["$","p","68",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Policy coordination"}],["$","span","1",{"children":" is the third. China's Humanoid Robot Action Plan, issued by MIIT and five other ministries in 2025, set a national target of 100,000 deployed humanoids by 2027. The plan is not merely aspirational. It is backed by dedicated robotics industrial parks in Beijing, Shanghai, Shenzhen, Guangzhou, Hangzhou, and Chengdu — each offering subsidized facilities, streamlined permitting, and local government investment. National, provincial, and municipal programs are designed to complement rather than duplicate each other, creating a layered support structure that addresses everything from fundamental research to factory-floor deployment."}]]}],["$","img","70",{"src":"https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=800&q=80","alt":"A team of engineers collaborating around a humanoid robot prototype — Shenzhen's hardware ecosystem enables iteration cycles measured in days, not months","style":{"width":"100%","borderRadius":"12px","margin":"24px 0"}}],["$","p","71",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*Shenzhen's hardware ecosystem enables humanoid robot iteration cycles measured in days, not months — a structural advantage no other geography can match*"}]]}],["$","h2","73",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"Shanghai's 300 Billion Bet"}]]}],["$","p","75",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"If China's AI terminal revolution has a capital, it is Shanghai. And the city is betting big."}]]}],["$","p","77",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"At the July 7 WAIC press conference, Shanghai's Vice Mayor Chen Jie revealed that the city's 394 large-scale AI enterprises generated a combined "}],["$","strong","1",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"637 billion RMB"}],["$","span","2",{"children":" ($87.8 billion) in revenue in 2025 — a year-on-year growth of 39.5%. That makes AI one of the fastest-growing sectors in Shanghai's economy, and the city is not content to rest on those laurels."}]]}],["$","p","79",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"By 2027, Shanghai aims to grow its smart terminal industry to "}],["$","strong","1",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"300 billion RMB"}],["$","span","2",{"children":" ($41.4 billion). The plan focuses on AI phones, AI PCs, AI wearables, and the software ecosystems that bind them together. It is not simply a manufacturing target. It is an ecosystem play: Shanghai wants to own the full stack, from chip design (via companies like Cambricon and Horizon Robotics) to operating system integration (via HarmonyOS and Xiaomi HyperOS) to application development (via the 169 approved large models)."}]]}],["$","div","88",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","thead",null,{"child