ren":"Bilingual, academic, research"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Academic & research terminals"}]]}]]}],["$","tr","5",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Baichuan 4"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Baichuan"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"54B"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Medical, legal verticals"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Healthcare & legal devices"}]]}]]}],["$","tr","6",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Hunyuan"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Tencent"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"70B"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Gaming, social, multimodal"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Tencent ecosystem integration"}]]}]]}],["$","tr","7",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Kimi K1.5"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Moonshot"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"32B"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Long context (2M tokens)"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Research & productivity devices"}]]}]]}]]}]]}]}],["$","p","112",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*Sources: Model provider technical reports; China AI regulatory filing registry; industry benchmarks.*"}]]}],["$","p","114",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The diversity of this model ecosystem is its strength. Where the U.S. market has consolidated around a handful of models (GPT-4, Claude, Gemini, Llama), China's landscape remains genuinely competitive. A developer building an AI-native application for Chinese terminals can choose from models optimized for coding, medical diagnosis, scientific computing, gaming, or social interaction — each with its own strengths and target hardware."}]]}],["$","p","116",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"This model diversity also drives hardware diversity. Qualcomm and MediaTek dominate the AI phone chip market globally, but in China, Huawei's Ascend and Kirin chips, Cambricon's MLU series, and Horizon Robotics' Journey chips all compete for design wins. The result is a hardware ecosystem that is more resilient to single-supplier disruption than any other major market."}]]}],["$","h2","118",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"The Global Implications"}]]}],["$","p","120",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"What does China's AI terminal crossover mean for the rest of the world? The answer depends on where you sit."}]]}],["$","p","122",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"For "}],["$","strong","1",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"semiconductor companies"}],["$","span","2",{"children":", China represents both the largest opportunity and the most complex challenge. The AI terminal market is driving unprecedented demand for NPU-equipped chips, memory, and sensors. But U.S. export restrictions on advanced AI chips have pushed Chinese manufacturers toward domestic alternatives. Huawei's Ascend 910B and 910C chips, while not yet matching NVIDIA's H100 in raw performance, are closing the gap rapidly — and they are available in quantities that NVIDIA's restricted products cannot match in the Chinese market."}]]}],["$","div","131",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Region"}]]}],["$","th","1",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"AI PC Share (2026)"}]]}],["$","th","2",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"AI Phone Share"}]]}],["$","th","3",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Total AI Terminal Value"}]]}],["$","th","4",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Growth Rate"}]]}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"China"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"29% of global"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"35% of global"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$185 billion"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"+32% YoY"}]]}]]}],["$","tr","1",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"North America"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"38% of global"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"28% of global"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$210 billion"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"+18% YoY"}]]}]]}],["$","tr","2",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Europe"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"18% of global"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"20% of global"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$95 billion"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"+14% YoY"}]]}]]}],["$","tr","3",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Rest of Asia"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"12% of global"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"14% of global"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$68 billion"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"+26% YoY"}]]}]]}],["$","tr","4",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Others"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"3% of global"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"3% of global"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$15 billion"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"+11% YoY"}]]}]]}]]}]]}]}],["$","p","132",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*Sources: IDC AI PC market forecast, April 2026; Canalys smartphone AI market analysis; AI in China estimates.*"}]]}],["$","p","134",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"For "}],["$","strong","1",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"consumer electronics brands"}],["$","span","2",{"children":", the message is clear: AI is no longer a premium feature. It is the baseline. Apple's delayed entry into on-device AI (Apple Intelligence launched in late 2025 with limited Chinese market support) has ceded precious ground to domestic competitors. Samsung's Galaxy AI has gained traction in China but faces the same challenge: Chinese consumers increasingly expect AI capabilities that are deeply integrated with local services, languages, and regulatory frameworks."}]]}],["$","p","136",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"For "}],["$","strong","1",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"robotics companies"}],["$","span","2",{"children":", China's humanoid scale represents a competitive threat — but also a potential partnership opportunity. The sub-$10,000 humanoid arms already being produced by Chinese manufacturers are finding customers in Southeast Asia, South America, and Africa — markets where affordable automation is unlocking industrial capability for the first time. Chinese robotic arm exports have grown 4.45x from 2020 to 2025. This is not a zero-sum game. It is a market expansion."}]]}],["$","p","138",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"For "}],["$","strong","1",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"policymakers"}],["$","span","2",{"children":", the China model offers a study in coordinated industrial policy. The combination of national targets (100,000 humanoids by 2027), local investment (Shanghai's 300 billion RMB terminal target), and regulatory framework (169 approved models) creates a system that is more predictable than laissez-faire approaches but more flexible than central planning. Whether this model is replicable elsewhere depends on local institutional capacity, but the results are hard to ignore."}]]}],["$","img","140",{"src":"https://images.unsplash.com/photo-1504639725590-34d0984388bd?w=800&q=80","alt":"A futuristic data center with glowing server racks — China's 160,000+ petaflops of intelligent computing power is one of the largest AI-dedicated infrastructures on Earth","style":{"width":"100%","borderRadius":"12px","margin":"24px 0"}}],["$","p","141",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*China's 160,000+ petaflops of intelligent computing power — one of the largest AI-dedicated infrastructures on Earth — is the invisible engine behind every AI terminal and humanoid robot*"}]]}],["$","h2","143",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"The Road Ahead: WAIC and Beyond"}]]}],["$","p","145",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"All of these threads converge in one place: the 2026 World Artificial Intelligence Conference, opening July 17 in Shanghai. With an exhibition area exceeding 100,000 square meters for the first time, 1,100+ exhibitors, 3,000+ exhibits, and 300+ products making their global debut, WAIC 2026 is positioned as the definitive showcase of where AI is heading — not just in China, but globally."}]]}],["$","p","147",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The conference has expanded beyond its traditional Shanghai Expo venue to a \"three locations, four venues\" layout spanning Expo, Zhangjiang, and West Bund. This physical expansion mirrors the thematic expansion: WAIC is no longer just a trade show. It is an ecosystem event that spans forums, exhibitions, competitions, application experiences, innovation incubation, and talent recruitment."}]]}],["$","div","158",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"WAIC 2026 Metric"}]]}],["$","th","1",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Figure"}]]}],["$","th","2",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Notes"}]]}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Exhibition Area"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"100,000+ sqm"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"First time exceeding 100K; 3 locations"}]]}]]}],["$","tr","1",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Exhibitors"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"1,100+"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"200+ each in intelligent computing & embodied AI tracks"}]]}]]}],["$","tr","2",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Global Debuts"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"300+ products"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Includes humanoid robots, AI agent phones, 3D near-memory chips"}]]}]]}],["$","tr","3",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Forums"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"140+"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"1,400+ speakers; 9 Turing/ Nobel laureates confirmed"}]]}]]}],["$","tr","4",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Academic Papers"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"284"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"WAIC Academic — first-ever international AI academic conference"}]]}]]}],["$","tr","5",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Startups"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"160"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"WAIC Future Tech zone; <13% selection rate from 1,000+ applicants"}]]}]]}],["$","tr","6",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Investors"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"200+"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Dedicated capital matching for startups"}]]}]]}]]}]]}]}],["$","p","159",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*Sources: Shanghai Municipal Government WAIC press briefing, July 7, 2026; WAIC official announcements.*"}]]}],["$","p","161",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Among the products debuting at WAIC: Huawei's Atlas 950 supercomputer (the largest supernode display in the industry), MiniMax's M3 multimodal model, Stepfun's Agent OS, 3D near-memory computing chips, the world's first AI agent phone, and multiple humanoid robots and AI dexterous hands. The intelligent computing and embodied AI tracks alone each feature more than 200 companies."}]]}],["$","p","163",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The academic dimension is equally significant. WAIC Academic, the conference's first-ever international academic track, has received 284 submissions from 11 countries. Papers accepted will be published by Springer. The presence of nine Turing Award and Nobel laureates — including Andrew Yao as conference chair and Richard Sutton as international co-chair — signals China's ambition to be not just a consumer of AI research but a producer of foundational knowledge."}]]}],["$","p","165",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Looking beyond WAIC, the trajectory is clear. China's AI industry is projected to grow at 30%+ annually through at least 2027. The 100,000 humanoid robot target for 2026 is likely to be exceeded, not missed. And the AI terminal crossover — the moment when AI devices became the majority — is not an endpoint. It is a starting point for the next phase: AI-native devices that are not merely smarter versions of old products, but entirely new categories of product that we do not yet have names for."}]]}],["$","h2","167",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"What the World Is Saying"}]]}],["$","p","169",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Zhihu"}],["$","span","1",{"children":" — *Comment on AI terminal market analysis*"}]]}],["$","blockquote","173",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"从2023年的AI洗白到现在的真AI设备，中国只用了一年半。关键是供应链成本下来了，NPU芯片的价格比2024年降了60%以上。这才是真正的护城河。\""}]]}],["$","p","1",{"style":{"margin":"8px 0"},"children":[]}],["$","p","2",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"From AI washing in 2023 to genuine AI devices now, China took only a year and a half. The key is supply chain costs — NPU chip prices dropped over 60% since 2024. That's the real moat.\""}]]}]]}],["$","p","174",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Weibo"}],["$","span","1",{"children":" — *User reacting to 100,000 humanoid robot target*"}]]}],["$","blockquote","178",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"100000台人形机器人！这比科幻电影还科幻。但是想想深圳工厂14天就能出原型，突然觉得这数字很真实。\""}]]}],["$","p","1",{"style":{"margin":"8px 0"},"children":[]}],["$","p","2",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"100,000 humanoid robots! That's more sci-fi than sci-fi movies. But then you remember Shenzhen factories can produce a prototype in 14 days, and suddenly that number feels very real.\""}]]}]]}],["$","p","179",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Xiaohongshu"}],["$","span","1",{"children":" — *Lifestyle blogger reviewing AI phone features*"}]]}],["$","blockquote","183",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"刚换了AI手机，最大的感受不是某个功能多厉害，而是整个手机'懂'你了。拍照不用调参数，文档不用自己总结，连日程都会自动安排。这已经不是手机，是生活助理。\""}]]}],["$","p","1",{"style":{"margin":"8px 0"},"children":[]}],["$","p","2",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"Just switched to an AI phone. The biggest feeling isn't any specific feature — it's that the whole phone 'gets' you. No need to adjust camera settings, no need to summarize documents yourself, even your schedule arranges automatically. This isn't a phone anymore. It's a life assistant.\""}]]}]]}],["$","p","184",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Twitter/X"}],["$","span","1",{"children":" — *Tech analyst on global AI hardware competition*"}]]}],["$","blockquote","186",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"China's AI terminal numbers are impressive but let's not forget — 90% of these devices run on Arm or Qualcomm chips. The real test is whether Huawei Ascend and Cambricon can replace them before the next export ban.\""}]]}]]}],["$","p","187",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Douban"}],["$","span","1",{"children":" — *Discussion on AI companionship and humanoid robots*"}]]}],["$","blockquote","191",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"AI陪伴要被禁了，人形机器人却要量产10万台。这很矛盾吗？仔细想想并不——一个情感依赖，一个工具替代。政策在试图划一条清晰的线：AI可以帮你干活，但不应该让你爱上它。\""}]]}],["$","p","1",{"style":{"margin":"8px 0"},"children":[]}],["$","p","2",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"AI companionship is being banned, but humanoid robots are going into mass production of 100,000 units. Is that contradictory? Think carefully and it isn't — one is emotional dependency, the other is tool replacement. Policy is trying to draw a clear line: AI can help you work, but it shouldn't make you fall in love with it.\""}]]}]]}],["$","p","192",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"GitHub"}],["$","span","1",{"children":" — *Developer comment on open-source robotics frameworks*"}]]}],["$","blockquote","194",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"The most underrated part of China's robot boom is the open-source ecosystem. AgiBot open-sourced their entire control stack. Unitree's ROS 2 packages are better documented than most Western alternatives. If you're building robots, you should be reading Chinese GitHub repos right now.\""}]]}]]}],["$","h2","195",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"The Crossover Is Not the End"}]]}],["$","p","197",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"In 2026, China's AI terminals crossed a threshold. For the first time, devices that think outsold devices that don't. Humanoid robots moved from prototypes to production lines at scale. And a trillion-RMB industry proved that it could grow faster than skeptics predicted."}]]}],["$","p","199",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"But the crossover is not the end. It is the beginning of a new phase — one where the distinction between \"AI device\" and \"non-AI device\" becomes meaningless because every device is AI-capable. Where humanoid robots are not novelties but standard equipment. Where the world's largest manufacturing base becomes the world's largest robot manufacturer, and the world's largest consumer market becomes the world's largest AI application laboratory."}]]}],["$","p","201",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The 2026 World Artificial Intelligence Conference will open its doors in seven days. It will showcase 300 products that do not exist in the global market today. Some will fail. Some will transform industries. All of them will be built in an ecosystem that has crossed the threshold from potential to kinetic energy."}]]}],["$","p","203",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"For the rest of the world, the question is no longer whether China's AI revolution is real. The question is how to engage with it — as competitor, partner, customer, or observer. Because one thing is certain: the devices that just overtook the old world are not looking back."}]]}],["$","hr","205",{"style":{"border":"none","borderTop":"1px solid #1a1a1a","margin":"32px 0"}}],["$","p","207",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*Related Articles:*"}]]}],["$","p","208",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"- "}],["$","a","1",{"href":"/blog/china-ai-companion-ban-doubao-qwen-digital-friends-lost-2026/","style":{"color":"#22d3ee","textDecoration":"underline"},"children":"China's AI Companion Ban: When 345 Million Users Lose Their Digital Friends"}]]}],["$","p","209",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"- "}],["$","a","1",{"href":"/blog/china-embodied-intelligence-infrastructure-ndrc-robots-factories-malls-homes/","style":{"color":"#22d3ee","textDecoration":"underline"},"children":"China's Embodied Intelligence Infrastructure: How Robots Are Invading Factories, Malls, and Homes"}]]}],["$","p","210",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"- How China's AI Video Models Captured the Global Creative Frontier]"}]]}],["$","p","211",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"- "}],["$","a","1",{"href":"/blog/china-multimodal-ai-revolution-end-text-only-2026/","style":{"color":"#22d3ee","textDecoration":"underline"},"children":"China's Multimodal AI Revolution: The End of Text-Only Models"}]]}]]}],["$","div",null,{"style":{"marginTop":"48px","padding":"24px","backgroundColor":"#111","border":"1px solid #1a1a1a","borderRadius":"12px","display":"flex","alignItems":"center","gap":"16px"},"children":[["$","div",null,{"style":{"width":"48px","height":"48px","borderRadius":"50%","backgroundColor":"#22d3ee","display":"flex","alignItems":"center","justifyContent":"center","fontSize":"20px","fontWeight":700,"color":"#0a0a0a","flexShrink":0},"children":"M"}],["$","div",null,{"children":[["$","p",null,{"style":{"margin":"0 0 4px","fontWeight":"600","color"