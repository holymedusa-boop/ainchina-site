,{"children":"Direct/indirect SASAC/MIIT affiliation"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Threatening lawsuit; aggressive public stance"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"-0.5% (HK)"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Lancaster, CA factory"}]]}]]}],["$","tr","3",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"NIO"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Indirect SASAC affiliation"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"No formal response yet"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Gave back +2% gains"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"San Jose R&D center"}]]}]]}],["$","tr","4",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Unitree"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Robotics/military applications"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"No formal response yet"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"—"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Nvidia partnership (academic)"}]]}]]}],["$","tr","5",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"WuXi AppTec"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Biotech/military-civil fusion"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Lawsuit filed June 11"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"—"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Deep US pharma ties"}]]}]]}]]}]]}]}],["$","p","66",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*Sources: Company filings, Reuters, AP, Bloomberg, Yahoo Finance.*"}]]}],["$","h2","68",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"China's Retaliation: Export Controls and Diplomatic Pressure"}]]}],["$","p","70",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Beijing's response to the blacklist has been swift and multi-layered. On June 13, China's Ministry of Commerce spokesperson stated that the U.S. had \"disregarded the consensus reached at the Beijing meeting between the two heads of state\"—a reference to the Trump-Xi summit in May 2026—and \"unreasonably suppressed Chinese enterprises.\" The spokesperson warned that China would \"resolutely and forcefully retaliate.\""}]]}],["$","p","72",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"That retaliation came quickly. On June 24, the same day Alibaba filed its lawsuit, China imposed export controls on "}],["$","strong","1",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"10 U.S. companies"}],["$","span","2",{"children":" involved in defense and rare earths mining. The companies were not named publicly, but the message was clear: Washington's blacklist would not go unanswered. China controls approximately 60% of global rare earths production and 85% of processing capacity. Export controls on these materials—essential for everything from electric vehicle motors to precision-guided munitions—represent a lever Beijing has used before and will use again."}]]}],["$","p","74",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The diplomatic dimension is equally significant. The blacklist expansion comes just weeks after President Trump and President Xi met in Beijing to stabilize bilateral relations. The two leaders agreed to boost economic ties, including China's purchase of more American agricultural products and Boeing jets. The Pentagon's decision to expand the blacklist so soon after that summit is viewed in Beijing as a betrayal of that consensus—and a sign that the U.S. national security apparatus operates independently of, and sometimes in opposition to, the diplomatic track."}]]}],["$","h2","76",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"The Structural Paradox: How Pressure Breeds Independence"}]]}],["$","p","78",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The most consequential effect of the Pentagon's blacklist may be the one least visible in headlines. Every time a major Chinese company is designated as a military entity, that company—and its competitors—accelerate plans to reduce dependence on American technology, capital, and markets. The mechanism is straightforward: if the U.S. government might cut you off tomorrow, you build alternatives today."}]]}],["$","p","80",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Consider the semiconductor industry. When Huawei was first added to the Entity List in 2019, the company was dependent on American chips, software, and design tools. Seven years later, Huawei has built a domestic chip ecosystem—Ascend AI chips, HiSilicon designs, CANN software—that has achieved near-parity with NVIDIA for many Chinese AI workloads. The 2025-2026 surge in Huawei's AI chip revenue, projected at $12 billion, is a direct consequence of the pressure that was supposed to contain it."}]]}],["$","p","82",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The same dynamic is now playing out across the tech stack. Alibaba, facing its 1260H designation, has accelerated its in-house chip development through T-Head (Zhenwu M890). ByteDance, anticipating further restrictions, has placed a $5.6 billion order for Huawei Ascend chips and is developing 350,000 custom inference chips through Samsung. Baidu's Kunlunxin chip division is expanding its second and third-generation AI accelerators. These investments were already planned; the blacklist is accelerating their deployment."}]]}],["$","div","91",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Domestic Substitution Acceleration"}]]}],["$","th","1",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"2023"}]]}],["$","th","2",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"2024"}]]}],["$","th","3",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"2025"}]]}],["$","th","4",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"2026 (Projected)"}]]}],["$","th","5",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Catalyst"}]]}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Huawei AI chip revenue"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~$1.5B"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~$3.2B"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~$7.5B"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~$12.0B"}]]}],["$","td","5",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Entity List (2019)"}]]}]]}],["$","tr","1",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Chinese AI chip market share (domestic)"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~18%"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~28%"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~42%"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"~52%"}]]}],["$","td","5",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"NVIDIA export controls"}]]}]]}],["$","tr","2",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"ByteDance Huawei orders"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$0"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$0.8B"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"$$2.5B"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"$$5.6B"}]]}],["$","td","5",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"1260H + entity list"}]]}]]}],["$","tr","3",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Alibaba T-Head chip investment"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Low"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Moderate"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"High"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Very High"}]]}],["$","td","5",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"1260H (Jun 2026)"}]]}]]}],["$","tr","4",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Baidu Kunlunxin shipments"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~20K"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~50K"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~120K"}]]}],["$","td","4",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"~250K"}]]}],["$","td","5",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Entity List precedent"}]]}]]}]]}]]}]}],["$","p","92",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*Sources: Financial Times, Reuters, Bernstein Research, company disclosures, industry estimates.*"}]]}],["$","p","94",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The pattern is clear enough that even American analysts have noted it. Dan Hutcheson, vice chairman of TechInsights, told EE Times in early 2026: \"We are witnessing the de-Americanization of China's AI infrastructure in real time. Nvidia going from $14 billion to potentially under $10 billion in China while Huawei doubles its revenue—that is not a temporary blip. That is a structural shift driven by policy, not technology.\""}]]}],["$","h2","96",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"The AI Stack Splits: What a Bifurcated World Looks Like"}]]}],["$","p","98",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The blacklist is not merely a trade policy tool. It is a forcing function for the global bifurcation of the AI technology stack. In 2024, the world's AI systems ran on a single hardware paradigm: NVIDIA GPUs, CUDA software, TSMC manufacturing. By 2026, that monoculture is ending. What is emerging is a dual-track world where Western AI runs on NVIDIA/AMD silicon and Chinese AI runs on Huawei Ascend and domestic alternatives—with increasingly incompatible software ecosystems, divergent cost structures, and separate talent pools."}]]}],["$","p","100",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"This has profound implications for AI development. When ByteDance trains Doubao on Huawei chips instead of H100s, the optimization choices ripple through every layer of the stack. When DeepSeek's V4 trains exclusively on Ascend silicon, the resulting model is not merely \"a Chinese alternative\" to GPT-5. It is a product of a different computational regime, optimized for different constraints, potentially capable of different capabilities."}]]}],["$","p","102",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The blacklist accelerates this divergence by eliminating the possibility of a middle ground. A Chinese company that might have hedged its bets—using NVIDIA chips for some workloads and Huawei for others—now faces pressure to go all-in on domestic suppliers. The 1260H designation doesn't explicitly ban NVIDIA purchases, but it signals that any Chinese company on the list could face additional restrictions at any moment. The rational response is to accelerate domestic substitution before the next shoe drops."}]]}],["$","h2","104",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"What the Blacklist Means for the Global AI Industry"}]]}],["$","p","106",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"For American companies, the blacklist creates a dilemma. NVIDIA has already seen its China revenue shrink from $14 billion to potentially under $10 billion as Chinese customers shift to Huawei. If the 1260H list continues to expand, more American companies will lose access to the world's second-largest AI market. The question is not whether the U.S. can slow China's AI development. The question is whether the slowing comes at a cost to American competitiveness that exceeds the benefit."}]]}],["$","p","108",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"For Chinese companies, the blacklist is a wake-up call that has already been answered. The 2025-2026 period has seen a surge in domestic AI chip orders, the maturation of CANN as a CUDA alternative, and the emergence of Chinese models that rival American frontiers on domestic hardware. The blacklist is a nudge; the Chinese response is a leap."}]]}],["$","p","110",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"For the rest of the world, the blacklist forces a choice. Countries that want access to both American and Chinese technology—Southeast Asian nations, Middle Eastern sovereign wealth funds, European automakers—must navigate an increasingly complex landscape where the two ecosystems are not merely competitive but incompatible. The 1260H list doesn't just divide the U.S. and China. It divides the world into American-aligned and Chinese-aligned technology spheres."}]]}],["$","h2","112",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"The Road Ahead: Lawsuits, Retaliation, and a New Equilibrium"}]]}],["$","p","114",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Alibaba's lawsuit is the first major legal challenge to a 1260H designation, but it will not be the last. BYD is expected to file. Baidu may follow. The legal strategy is to force the Pentagon to provide evidence for its claims—a standard that the Defense Department, which has not publicly released detailed justification for any of the designations, may struggle to meet. If the courts find the designations arbitrary, the blacklist's credibility as a deterrent will erode."}]]}],["$","p","116",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Beijing's retaliation will likely escalate. The June 24 export controls on 10 American companies are a warning shot. China has already demonstrated its willingness to restrict rare earths exports, launch antitrust investigations against American companies, and impose counter-sanctions on defense-linked firms. The blacklist is a bilateral escalation ladder, and both sides are climbing."}]]}],["$","p","118",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The most likely long-term outcome is not a return to integration but a new equilibrium of managed separation. American and Chinese technology ecosystems will operate in parallel, with limited exchange at the boundaries. Companies in both countries will build redundant supply chains. Investors will price geopolitical risk into every cross-border deal. The global AI industry will become less efficient but more resilient—and the Pentagon's blacklist will be remembered as the policy that made the split official."}]]}],["$","blockquote","122",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"@TechInvestor_Liu:"}],["$","span","1",{"children":" \"Pentagon puts Alibaba on the military list. Alibaba's response: sue them. This is peak 2026. The US government treats e-commerce like weapons, and the response is a First Amendment lawsuit. Globalization is officially broken.\""}]]}],["$","p","1",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"— Liu Wei, technology analyst, Shanghai"}]]}]]}],["$","blockquote","125",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"@SiliconValleyWatcher:"}],["$","span","1",{"children":" \"Alibaba's board has American VCs, BlackRock holds shares, and their cloud runs PyTorch. But sure, they're a military company. The 1260H list has become a tool for industrial policy masquerading as national security.\""}]]}],["$","p","1",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"— Sarah Chen, venture capitalist, Palo Alto"}]]}]]}],["$","blockquote","128",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"@BeijingEngineer:"}],["$","span","1",{"children":" \"美国把中国电商公司列入军事名单，实际上是在帮华为。每一个被拉黑的公司都会加速转向国产芯片。到2027年，中国的AI基础设施可能完全不需要美国技术。\" (Translation: \"The US putting Chinese e-commerce companies on the military list is actually helping Huawei. Every blacklisted company will accelerate its shift to domestic chips. By 2027, China's AI infrastructure may not need American technology at all.\")"}]]}],["$","p","1",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"— Zhang Ming, AI infrastructure engineer, Beijing"}]]}]]}],["$","blockquote","131",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"@EUTradeObserver:"}],["$","span","1",{"children":" \"The 1260H list is expanding faster than anyone predicted. From 70 to 188 entities in two years. European companies are already asking: if Alibaba and BYD are military companies, who's next? The uncertainty is the weapon.\""}]]}],["$","p","1",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"— Klaus Weber, trade policy analyst, Brussels"}]]}]]}],["$","h2","132",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"The Deeper Pattern"}]]}],["$","p","134",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The Pentagon's blacklist is not an isolated policy. It is one element of a broader American strategy to slow China's technological rise through what analysts call \"small yard, high fence\" restrictions—targeting the most sensitive technologies while maintaining broader economic ties. The problem is that the yard keeps getting bigger and the fence keeps getting higher. What began with Huawei and ZTE in 2019 has expanded to encompass AI chips, biotechnology, electric vehicles, and now China's largest consumer technology companies."}]]}],["$","p","136",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Each expansion has a rationale. Huawei was building 5G infrastructure that could be used for surveillance. DJI's drones were deployed by the Chinese military. CATL's batteries could power military vehicles. Alibaba's cloud could host sensitive data. The logic is cumulative: if any technology can be used for military purposes, all technology is suspect. And if all technology is suspect, the blacklist has no natural limit."}]]}],["$","p","138",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"This is the paradox at the heart of America's China strategy. The tighter the fence, the more incentive Chinese companies have to build their own yard. The more Chinese companies build their own yard, the less leverage American restrictions have. The blacklist was designed to slow China's tech advance. Instead, it is funding the very independence it was meant to prevent."}]]}],["$","p","140",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"On June 24, 2026, as Alibaba's lawyers filed their complaint in California and China's Ministry of Commerce announced export controls on American rare earths miners, the trajectory became clear. The U.S. and China are not merely decoupling. They are constructing two parallel technological civilizations. The Pentagon's blacklist is the blueprint for one of them. Whether it was the right blueprint will be debated for decades. But the construction has already begun."}]]}],["$","hr","142",{"style":{"border":"none","borderTop":"1px solid #1a1a1a","margin":"32px 0"}}],["$","p","144",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*What do you think about the Pentagon's blacklist expansion? Are these designations justified national security measures, or are they accelerating a tech decoupling that will hurt both economies? Share your perspective in the comments below.*"}]]}],["$","p","146",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"*For more deep-dive analysis on China's AI and technology landscape, follow "}],["$","a","1",{"href":"/","style":{"color":"#22d3ee","textDecoration":"underline"},"children":"AI in China"}],["$","span","2",{"children":". Tomorrow's coverage examines how Chinese AI models are beginning to dominate global API traffic—and what that means for the future of AI pricing.*"}]]}]]}],["$","div",null,{"style":{"marginTop":"48px","padding":"24px","backgroundColor":"#111","border":"1px solid #1a1a1a","borderRadius":"12px","display":"flex","alignItems":"center","gap":"16px"},"children":[["$","div",null,{"style":{"width":"48px","height":"48px","borderRadius":"50%","backgroundColor":"#22d3ee","display":"flex","alignItems":"center","justifyContent":"center","fontSize":"20px","fontWeight":700,"color":"#0a0a0a","flexShrink":0},"children":"M"}],["$","div",null,{"children":[["$","p",null,{"style":{"margin":"0 0 4px","fontWeight":"600","color":"#f5f5f5","fontSize":"15px"},"children":["$","$L3",null,{"href":"/about/","style":{"color":"#22d3ee","textDecoration":"none"},"children":"By Meeeeed"}]}],["$","p",null,{"style":{"margin":"0","color":"#737373","fontSize":"13px","lineHeight":1.5},"children":["Editor at AI in China. Tracking Chinese AI companies, funding rounds, and the technologies reshaping global tech. ",["$","a",null,{"href":"/about/","style":{"color":"#a3a3a3","textDecoration":"underline"},"children":"More about me"}],"."]}]]}]]}]]}],["$","div",null,{"style":{"maxWidth":"800px","margin":"0 auto","padding":"0 24px"},"children":["$","div",null,{"style":{"display":"flex","gap":"16px","flexWrap":"wrap","justifyContent":"space-between","borderTop":"1px solid #1a1a1a","paddingTop":"32px","marginBottom":"32px"},"children":[["$","$L3",null,{"href":"/blog/moonshot-kimi-k3-2-8-trillion-open-ai-china-2026/","style":{"flex":"1 1 300px","padding":"20px","backgroundColor":"#111","border":"1px solid #1a1a1a","borderRadius":"12px","textDecoration":"none","color":"#e5e5e5"},"children":[["$","p",null,{"style":{"margin":"0 0 8px","color":"#737373","fontSize":"13px"},"children":"← Previous"}],["$","p",null,{"style":{"margin":0,"fontWeight":"600","fontSize":"15px","lineHeight":1.4},"children":"Moonshot's Kimi K3: How a 2.8-Trillion-Parameter Open-Weight Model Shook Global Markets"}]]}],["$","$L3",null,{"href":"/blog/qwen-billion-downloads-china-open-source-ai-dominance-2026/","style":{"flex":"1 1 300px","padding":"20px","backgroundColor":"#111","border":"1px solid #1a1a1a","borderRadius":"12px","textDecoration":"none","color":"#e5e5e5","textAlign":"right"},"children":[["$","p",null,{"style":{"margin":"0 0 8px","color":"#737373","fontSize":"13px"},"children":"Next →"}],["$","p",null,{"style":{"margin":0,"fontWeight":"600","fontSize":"15px","lineHeight":1.4},"children":"Qwen's Open-Source Conquest: How China's AI Model Captured a Billion Downloads and Redrew Global Developer Economics"}]]}]]}]}],["$","footer",null,{"style":{"padding":"48px 24px","borderTop":"1px solid #1a1a1a","textAlign":"center"},"children":[["$","div",null,{"style":{"maxWidth":"800px","margin":"0 auto","display":"flex","justifyContent":"center","gap":"24px","flexWrap":"wrap","marginBottom":"24px"},"children":[["$","$L3",null,{"href":"/","style":{"color":"#a3a3a3","textDecoration":"none","fontSize":"14px"},"children":"Home"}],["$","$L3",null,{"href":"/blog/","style":{"color":"#a3a3a3","textDecoration":"none","fontSize":"14px"},"children":"Blog"}],["$","$L3",null,{"href":"/about/","style":{"color":"#a3a3a3","textDecoration":"none","fontSize":"14px"},"children":"About"}],["$","$L3",null,{"href":"/contact/","style":{"color":"#a3a3a3","textDecoration":"none","fontSize":"14px"},"children":"Contact"}],["$","$L3",null,{"href":"/privacy/","style":{"color":"#a3a3a3","textDecoration":"none","fontSize":"14px"},"children":"Privacy"}],["$","$L3",null,{"href":"/terms/","style":{"color":"#a3a3a3","textDecoration":"none","fontSize":"14px"},"children":"Terms"}]]}],["$","p",null,{"style":{"color":"#737373","fontSize":"14px"},"children":"© 2026 AI in China. All rights reserved."}]]}]]}]]],null],null]},["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children","$5","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","blog","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined","styles":null}],null]},[["$","html",null,{"lang":"en","children":[["$","head",null,{"children":[["$","link",null,{"rel":"icon","type":"image/svg+xml","href":"/favicon.svg"}],["$","script",null,{"async":true,"src":"https://www.googletagmanager.com/gtag/js?id=G-GK21PLH8V8"}],["$","script",null,{"dangerouslySetInnerHTML":{"__html":"\n              window.dataLayer = window.dataLayer || [];\n              function gtag(){dataLayer.push(arguments);}\n              gtag('js', new Date());\n              gtag('config', 'G-GK21PLH8V8');\n            "}}],["$","script",null,{"src":"https://quge5.com/88/tag.min.js","data-zone":"245313","async":true,"data-cfasync":"false"}]]}],["$","body",null,{"style":{"margin":0,"padding":0,"fontFamily":"-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif"},"children":[["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":["$","div",null,{"style":{"minHeight":"100vh","backgroundColor":"#0a0a0a","color":"#e5e5e5","display":"flex","flexDirection":"column","alignItems":"center","justifyContent":"center","padding":"48px 24px","textAlign":"center"},"children":[["$","div",null,{"style":{"fontSize":"80px","fontWeight":700,"color":"#22d3ee","marginBottom":"16px"},"children":"404"}],["$","h1",null,{"style":{"fontSize":"28px","fontWeight":600,"margin":"0 0 16px","color":"#f5f5f5"},"children":"Page Not Found"}],["$","p",null,{"style":{"color":"#a3a3a3","fontSize":"16px","lineHeight":1.6,"maxWidth":"500px","marginBottom":"32px"},"children":"The page you are looking for does not exist or has been moved."}],["$","div",null,{"style":{"display":"flex","gap":"16px","flexWrap":"wrap","justifyContent":"center"},"children":[["$","a",null,{"href":"/","style":{"padding":"12px 24px","backgroundColor":"#22d3ee","color":"#0a0a0a","textDecoration":"none","borderRadius":"8px","fontWeight":"600","fontSize":"15px"},"children":"Go Home"}],["$","a",null,{"href":"/blog/","style":{"padding":"12px 24px","backgroundColor":"#1a1a1a","color":"#e5e5e5","textDecoration":"none","borderRadius":"8px","fontWeight":"600","fontSize":"15px","border":"1px solid #2a2a2a"},"children":"Browse Blog"}]]}]]}],"notFoundStyles":[],"styles":null}],["$","$L7",null,{}]]}]]}],null],null],[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/5203c8bbf83ac0bc.css","precedence":"next","crossOrigin":"$undefined"}]],"$L8"]]]]
8:[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}],["$","meta","1",{"charSet":"utf-8"}],["$","title","2",{"children":"The Pentagon's Blacklist Gamble: Why Adding Alibaba, Baidu, and BYD to the Military List Is Accelerating the Very Decoupling It Seeks to Prevent | AI in China"}],["$","meta","3",{"name":"description","content":"On June 8, 2026, the Pentagon added Alibaba, Baidu, BYD, and NIO to its Chinese Military Companies list. By June 24, Alibaba had sued the U.S. government. The blacklist now covers 188 entities—a 45% expansion in one year. But the real story isn't the legal fight. It's how Washington's escalating pressure is forcing China's tech giants to build a parallel ecosystem that may soon need no American technology at all."}],["$","link","4",{"rel":"author","href":"https://www.ainchina.com/about/"}],["$","meta","5",{"name":"author","content":"Meeeeed@AI in China"}],["$","meta","6",{"name":"keywords","content":"[\"Pentagon blacklist\", \"Chinese Military Companies list\", \"Alibaba lawsuit\", \"BYD\", \"Baidu\", \"NIO\", \"US China tech decoupling\", \"Section 1260H\", \"China tech sanctions\", \"military-civil fusion\", \"Huawei\", \"AI chips\", \"China semiconductor independence\"]"}],["$","meta","7",{"name":"creator","content":"AI in China"}],["$","meta","8",{"name":"publisher","content":"AI in China"}],["$","meta","9",{"name":"robots","content":"index, follow"}],["$","meta","10",{"name":"googlebot","content":"index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"}],["$","link","11",{"rel":"canonical","href":"https://www.ainchina.com/blog/pentagon-blacklist-alibaba-baidu-byd-china-tech-decoupling-2026/"}],["$","meta","12",{"property":"og:title","content":"The Pentagon's Blacklist Gamble: Why Adding Alibaba, Baidu, and BYD to the Military List Is Accelerating the Very Decoupling It Seeks to Prevent"}],["$","meta","13",{"property":"og:description","content":"On June 8, 2026, the Pentagon added Alibaba, Baidu, BYD, and NIO to its Chinese Military Companies list. By June 24, Alibaba had sued the U.S. government. The blacklist now covers 188 entities—a 45% expansion in one year. But the real story isn't the legal fight. It's how Washington's escalating pressure is forcing China's tech giants to build a parallel ecosystem that may soon need no American technology at all."}],["$","meta","14",{"property":"og:url","content":"https://www.ainchina.com/blog/pentagon-blacklist-alibaba-baidu-byd-china-tech-decoupling-2026/"}],["$","meta","15",{"property":"og:image","content":"https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1200&q=80"}],["$","meta","16",{"property":"og:image:width","content":"1200"}],["$","meta","17",{"property":"og:image:height","content":"600"}],["$","meta","18",{"property":"og:image:alt","content":"The Pentagon's Blacklist Gamble: Why Adding Alibaba, Baidu, and BYD to the Military List Is Accelerating the Very Decoupling It Seeks to Prevent"}],["$","meta","19",{"property":"og:type","content":"article"}],["$","meta","20",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","21",{"name":"twitter:title","content":"The Pentagon's Blacklist Gamble: Why Adding Alibaba, Baidu, and BYD to the Military List Is Accelerating the Very Decoupling It Seeks to Prevent"}],["$","meta","22",{"name":"twitter:description","content":"On June 8, 2026, the Pentagon added Alibaba, Baidu, BYD, and NIO to its Chinese Military Companies list. By June 24, Alibaba had sued the U.S. government. The blacklist now covers 188 entities—a 45% expansion in one year. But the real story isn't the legal fight. It's how Washington's escalating pressure is forcing China's tech giants to build a parallel ecosystem that may soon need no American technology at all."}],["$","meta","23",{"name":"twitter:image","content":"https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1200&q=80"}]]
