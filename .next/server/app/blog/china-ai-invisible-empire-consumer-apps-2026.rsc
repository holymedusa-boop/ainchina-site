["$","span","0",{"children":"10M DAU"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Jun 2024"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"10 months"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Free access, aggressive marketing"}]]}]]}],["$","tr","3",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"30M DAU"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Oct 2024"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"14 months"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Voice mode, image generation features"}]]}]]}],["$","tr","4",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"50M DAU"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Jan 2025"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"17 months"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"DeepSeek integration, enterprise pilots"}]]}]]}],["$","tr","5",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"100M DAU"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Feb 2026"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~29 months"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Paid tier launch, content creation tools"}]]}]]}]]}]]}]}],["$","p","78",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Several factors drove this explosive growth. First, Doubao was free — completely free — for nearly its entire first two years. ByteDance treated it as a user acquisition and data-gathering investment, subsidizing inference costs to build habit formation. Second, Doubao wasn't just a chatbot; it was a content creation tool deeply integrated with Douyin (TikTok), allowing users to generate scripts, captions, and video concepts that could be immediately deployed to the world's largest short-video platform. Third, ByteDance's distribution advantage is almost unfair — Doubao appeared in Douyin ads, within Jinri Toutiao (news app), and as a default feature on millions of Android devices."}]]}],["$","p","80",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"But perhaps most importantly, Doubao understood something that Western AI companies are still learning: Chinese users don't want a \"assistant.\" They want a Swiss Army knife. Doubao writes essays, generates TikTok scripts, creates presentation slides, tutors math homework, translates documents, and drafts business emails — all within a single interface that feels more like a super-app than a chat window."}]]}],["$","blockquote","85",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Zhihu comment:"}]]}],["$","p","1",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"豆包现在是我手机里最常用的APP，排前三。早上查天气，中午写周报，晚上给孩子辅导作业。它不是最好的AI，但它是最好用的AI。\""}]]}],["$","p","2",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"*\"Doubao is now the most-used app on my phone, top three. Check weather in the morning, write weekly reports at noon, tutor my kid's homework at night. It's not the best AI, but it's the most usable AI.\"*"}]]}]]}],["$","p","86",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The monetization shift is equally significant. In May 2026, Doubao introduced paid tiers ranging from roughly $9.50 to $72 per month — a move that signals ByteDance's confidence that user habits are sticky enough to survive a transition from free to freemium. With 120 trillion daily tokens flowing through the system, the infrastructure costs of maintaining a free model had become unsustainable. The question now is whether users will pay — and whether competitors like Kimi (which has always been partially paid) can capture price-sensitive users who balk at Doubao's new fees."}]]}],["$","hr","88",{"style":{"border":"none","borderTop":"1px solid #1a1a1a","margin":"32px 0"}}],["$","h2","90",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"MiniMax's Global Gambit: From Shanghai to 200 Countries"}]]}],["$","p","92",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"If Doubao represents China's domestic AI dominance, MiniMax represents its international ambitions. The Shanghai-based startup, founded in 2021 by Yan Junjie and a team of former SenseTime researchers, has built something unprecedented: a Chinese AI company whose majority revenue comes from overseas markets."}]]}],["$","p","94",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"MiniMax's 2025 financials, revealed in its April 2026 IPO filing, tell a remarkable story:"}]]}],["$","div","104",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Metric"}]]}],["$","th","1",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"2024"}]]}],["$","th","2",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"2025"}]]}],["$","th","3",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Growth"}]]}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Total cumulative users"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"1.8 billion"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"2.36 billion"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"+31%"}]]}]]}],["$","tr","1",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Monthly active users"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"21.3 million"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"27.6 million"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"+30%"}]]}]]}],["$","tr","2",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Enterprise clients"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"156,000"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"214,000"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"+37%"}]]}]]}],["$","tr","3",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Revenue (est.)"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~$180M"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"~$310M"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"+72%"}]]}]]}],["$","tr","4",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Overseas revenue share"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"61%"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"73%"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"+12 pp"}]]}]]}],["$","tr","5",{"children":[["$","td","0",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Countries/territories served"}]]}],["$","td","1",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"180+"}]]}],["$","td","2",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"200+"}]]}],["$","td","3",{"style":{"borderBottom":"1px solid #1a1a1a","padding":"12px 16px","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Expanded"}]]}]]}]]}]]}]}],["$","p","105",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The company's product portfolio reveals a sophisticated dual-market strategy. Domestically, MiniMax operates Xingye (星野, \"Starlight\") — an AI companion app with anime-inspired avatars that targets China's Gen Z users with emotional support, character roleplay, and creative storytelling. Internationally, it operates Talkie, a more Western-facing AI companion platform that has found particular traction in the US, Southeast Asia, and Latin America."}]]}],["$","p","107",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The Talkie product is especially interesting because it represents a category — AI companions — that Western tech companies have largely avoided due to safety concerns and regulatory scrutiny. While OpenAI and Anthropic carefully distance themselves from \"companion\" use cases, MiniMax has embraced them wholeheartedly, building a business model around virtual goods (outfits, voice packs, personality upgrades) and premium subscriptions."}]]}],["$","p","109",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"MiniMax's planned Hong Kong IPO — which would make it the first \"large model first stock\" (大模型第一股) — is being watched as a bellwether for whether international investors will value Chinese AI companies on their consumer metrics rather than just their model benchmarks. If successful, it could open the floodgates for a wave of Chinese AI consumer companies to go public."}]]}],["$","blockquote","114",{"style":{"borderLeft":"4px solid #22d3ee","paddingLeft":"24px","margin":"24px 0","fontStyle":"italic","color":"#a3a3a3"},"children":[["$","p","0",{"style":{"margin":"8px 0"},"children":[["$","strong","0",{"style":{"color":"#f5f5f5","fontWeight":"700"},"children":"Weibo comment:"}]]}],["$","p","1",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"\"MiniMax要上市了，这意味着中国AI公司终于有了一条不靠卖课、不靠骗补贴的正经商业路径。Talkie在国外赚的钱是实打实的。\""}]]}],["$","p","2",{"style":{"margin":"8px 0"},"children":[["$","span","0",{"children":"*\"MiniMax is going public, which means Chinese AI companies finally have a legitimate business path that doesn't rely on selling courses or scamming subsidies. The money Talkie earns abroad is real.\"*"}]]}]]}],["$","hr","115",{"style":{"border":"none","borderTop":"1px solid #1a1a1a","margin":"32px 0"}}],["$","h2","117",{"style":{"fontSize":"28px","fontWeight":"600","margin":"40px 0 20px","color":"#f5f5f5"},"children":[["$","span","0",{"children":"The 700 Million MAU Ecosystem: Beyond Chatbots"}]]}],["$","p","119",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"The 700 million monthly active users across China's AI chatbot platforms don't represent 700 million people using a single chatbot. They represent a population that has integrated AI into the fabric of daily digital life in ways that go far beyond the \"ask a question, get an answer\" paradigm that dominates Western AI usage."}]]}],["$","p","121",{"style":{"fontSize":"16px","lineHeight":"1.8","margin":"16px 0","color":"#e5e5e5"},"children":[["$","span","0",{"children":"Consider the parallel AI ecosystems that exist within China's larger digital economy:"}]]}],["$","div","132",{"style":{"overflowX":"auto","margin":"24px 0"},"children":["$","table",null,{"style":{"width":"100%","borderCollapse":"collapse","fontSize":"14px"},"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","0",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Layer"}]]}],["$","th","1",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Primary Platforms"}]]}],["$","th","2",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"User Integration"}]]}],["$","th","3",{"style":{"borderBottom":"2px solid #22d3ee","padding":"12px 16px","textAlign":"left","fontWeight":"600","color":"#22d3ee"},"children":[["$","span","0",{"children":"Monetization"}]]}]]}]}],["$","tbo